{
    "optimizer": "Adam",
    "learning_rate": 0.001,
    "loss": "Sparse Categorical Crossentropy (with masking)",
    "batch_size": 32,
    "epochs": 10,
    "gradient_clipping": {
        "enabled": true,
        "max_norm": 5.0
    },
    "early_stopping": {
        "patience": 3,
        "metric": "validation_loss"
    },
    "masking": {
        "padding_index": 0,
        "strategy": "Ignore padding tokens in loss computation"
    }
}